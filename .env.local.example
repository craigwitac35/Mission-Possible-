# Copy this file to .env.local and fill in your Supabase project values.
# Find these in your Supabase dashboard under: Project Settings > API.

# Public-facing values (safe to expose in browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret. NEVER prefix with NEXT_PUBLIC_.
# Only used by getServiceSupabase() in server-side code if you add API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
